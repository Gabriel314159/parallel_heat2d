{
  "schema_version": 1,
  "kind": "correctness",
  "defaults": "../config/defaults.json",
  "description": "Planned small-field checks against matching serial references.",
  "checks": {
    "serial_parallel_atol": 1e-10,
    "serial_parallel_rtol": 1e-10,
    "fixed_boundaries": true,
    "constant_field_invariance": true,
    "analytical_error_reported_separately": true
  },
  "output": {"directory": "outputs/correctness", "write_field": true, "snapshot_interval": 0},
  "runs": [
    {
      "name": "heated_top_one_rank",
      "problem": {"nx": 32, "ny": 24, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 1, "omp_threads": 1, "decomposition": "rows", "exchange": "blocking"}
    },
    {
      "name": "uneven_rows_hybrid",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 3, "omp_threads": 2, "decomposition": "rows", "exchange": "blocking"}
    },
    {
      "name": "uneven_2d_blocking",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 6, "omp_threads": 2, "decomposition": "2d", "exchange": "blocking", "process_grid": [2, 3]}
    },
    {
      "name": "uneven_2d_overlap",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 6, "omp_threads": 2, "decomposition": "2d", "exchange": "overlap", "process_grid": [2, 3]}
    },
    {
      "name": "small_local_blocks_overlap",
      "problem": {"nx": 3, "ny": 3, "steps": 8},
      "execution": {"backend": "parallel", "mpi_ranks": 4, "omp_threads": 1, "decomposition": "2d", "exchange": "overlap", "process_grid": [2, 2]}
    },
    {
      "name": "constant_field",
      "problem": {"nx": 31, "ny": 23, "steps": 40, "case": "constant", "initial_temperature": 42.0, "boundaries": {"top": 42.0, "bottom": 42.0, "left": 42.0, "right": 42.0}},
      "execution": {"backend": "parallel", "mpi_ranks": 4, "omp_threads": 2, "decomposition": "2d", "exchange": "overlap", "process_grid": [2, 2]}
    },
    {
      "name": "sine_decay",
      "problem": {"nx": 40, "ny": 32, "steps": 40, "case": "sine_decay", "amplitude": 1.0, "boundaries": {"top": 0.0, "bottom": 0.0, "left": 0.0, "right": 0.0}},
      "execution": {"backend": "parallel", "mpi_ranks": 4, "omp_threads": 2, "decomposition": "2d", "exchange": "blocking", "process_grid": [2, 2]}
    }
  ]
}
