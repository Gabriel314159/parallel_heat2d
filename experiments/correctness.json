{
  "schema_version": 5,
  "kind": "correctness",
  "defaults": "../config/defaults.json",
  "description": "Experiment 0 (the gate before any timing): small-field checks against matching serial references, with the computed wind-driven flow and no-flux walls. A short spin-up at Re of about 50 (viscosity 0.02, wind 0.62) gives a developed flow on these coarse grids.",
  "checks": {
    "serial_parallel_atol": 1e-10,
    "serial_parallel_rtol": 1e-10,
    "mass_conservation_rtol": 1e-12,
    "constant_field_invariance": true,
    "cosine_decay_discrete_rtol": 1e-12,
    "analytical_error_reported_separately": true
  },
  "problem": {"blob_width": 0.15, "blob_centre": [0.3, 1.0], "viscosity": 0.02, "wind_amplitude": 0.62, "max_speed": 2.0, "spinup": 1.0, "check_interval": 10},
  "output": {"directory": "outputs/correctness", "write_field": true, "snapshot_interval": 0},
  "runs": [
    {
      "name": "pigment_one_rank",
      "problem": {"nx": 32, "ny": 24, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 1, "omp_threads": 1, "decomposition": "rows", "exchange": "blocking"}
    },
    {
      "name": "mpi_only_rows",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 3, "omp_threads": 1, "decomposition": "rows", "exchange": "blocking"}
    },
    {
      "name": "mpi_only_2d",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 6, "omp_threads": 1, "decomposition": "2d", "exchange": "blocking", "process_grid": [2, 3]}
    },
    {
      "name": "openmp_only",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 1, "omp_threads": 4, "decomposition": "rows", "exchange": "blocking"}
    },
    {
      "name": "uneven_rows_blocking",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 3, "omp_threads": 2, "decomposition": "rows", "exchange": "blocking"}
    },
    {
      "name": "uneven_rows_overlap",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 3, "omp_threads": 2, "decomposition": "rows", "exchange": "overlap"}
    },
    {
      "name": "uneven_2d_blocking",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 6, "omp_threads": 2, "decomposition": "2d", "exchange": "blocking", "process_grid": [2, 3]}
    },
    {
      "name": "uneven_2d_overlap",
      "problem": {"nx": 37, "ny": 29, "steps": 50},
      "execution": {"backend": "parallel", "mpi_ranks": 6, "omp_threads": 2, "decomposition": "2d", "exchange": "overlap", "process_grid": [2, 3]}
    },
    {
      "name": "periodic_wind_2d_overlap",
      "problem": {"nx": 37, "ny": 29, "steps": 50, "wind": "periodic", "wind_alpha": 0.5, "wind_period": 0.5},
      "execution": {"backend": "parallel", "mpi_ranks": 6, "omp_threads": 2, "decomposition": "2d", "exchange": "overlap", "process_grid": [2, 3]}
    },
    {
      "name": "small_local_blocks_overlap",
      "problem": {"nx": 3, "ny": 3, "steps": 8},
      "execution": {"backend": "parallel", "mpi_ranks": 4, "omp_threads": 1, "decomposition": "2d", "exchange": "overlap", "process_grid": [2, 2]}
    },
    {
      "name": "constant_field",
      "problem": {"nx": 31, "ny": 23, "steps": 40, "case": "constant", "background": 42.0},
      "execution": {"backend": "parallel", "mpi_ranks": 4, "omp_threads": 2, "decomposition": "2d", "exchange": "overlap", "process_grid": [2, 2]}
    },
    {
      "name": "cosine_decay",
      "problem": {"nx": 40, "ny": 32, "steps": 40, "case": "cosine_decay", "amplitude": 1.0, "wind_amplitude": 0.0, "max_speed": 0.0, "spinup": 0.0},
      "execution": {"backend": "parallel", "mpi_ranks": 4, "omp_threads": 2, "decomposition": "2d", "exchange": "blocking", "process_grid": [2, 2]}
    }
  ]
}
