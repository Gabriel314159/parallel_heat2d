{
  "schema_version": 1,
  "kind": "strategies",
  "defaults": "../config/defaults.json",
  "description": "Explicit cross-product of resource layouts, decompositions and exchanges at 16 total CPU cores.",
  "problem": {"nx": 4096, "ny": 4096, "steps": 1000},
  "execution": {"backend": "parallel"},
  "total_cores": 16,
  "resources": [
    {"mpi_ranks": 16, "omp_threads": 1},
    {"mpi_ranks": 8, "omp_threads": 2},
    {"mpi_ranks": 4, "omp_threads": 4},
    {"mpi_ranks": 2, "omp_threads": 8},
    {"mpi_ranks": 1, "omp_threads": 16}
  ],
  "decompositions": ["rows", "2d"],
  "exchanges": ["blocking", "overlap"],
  "warmup_runs": 1,
  "repetitions": 5,
  "output": {"directory": "outputs/strategies", "write_field": false, "snapshot_interval": 0},
  "metrics_csv": "results/raw/strategies.csv"
}
