{
  "schema_version": 2,
  "kind": "strategies",
  "defaults": "../config/defaults.json",
  "description": "Explicit cross-product of resource layouts, decompositions and exchanges at 16 total CPU cores. Same problem and flow as strong_scaling.json.",
  "problem": {
    "nx": 4096, "ny": 4096, "lx": 1.0, "ly": 1.0, "steps": 1000,
    "kappa": 0.005,
    "flow_amplitude": 0.1, "flow_epsilon": 0.25, "flow_period": 10.0,
    "case": "pigment_drop", "background": 0.0, "amplitude": 1.0,
    "blob_centre": [0.5, 0.5], "blob_width": 0.05
  },
  "execution": {"backend": "parallel"},
  "total_cores": 16,
  "resources": [
    {"mpi_ranks": 16, "omp_threads": 1},
    {"mpi_ranks": 8, "omp_threads": 2},
    {"mpi_ranks": 4, "omp_threads": 4},
    {"mpi_ranks": 2, "omp_threads": 8},
    {"mpi_ranks": 1, "omp_threads": 16}
  ],
  "decompositions": ["rows", "2d"],
  "exchanges": ["blocking", "overlap"],
  "warmup_runs": 1,
  "repetitions": 5,
  "output": {"directory": "outputs/strategies", "write_field": false, "snapshot_interval": 0},
  "metrics_csv": "results/raw/strategies.csv"
}
