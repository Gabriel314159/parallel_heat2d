{
  "schema_version": 5,
  "kind": "strategies",
  "defaults": "benchmark_problem.json",
  "description": "Follow-up to experiment 3: the fixed problem P on the 64 cores of one node (32 per socket), split between ranks and threads in six ways, from 64 ranks x 1 thread to 2 ranks x 32 threads. It separates the effect of mixing ranks and threads from the effect of crossing nodes in experiment 3.",
  "execution": {
    "backend": "parallel"
  },
  "total_cores": 64,
  "resources": [
    {
      "mpi_ranks": 64,
      "omp_threads": 1
    },
    {
      "mpi_ranks": 32,
      "omp_threads": 2
    },
    {
      "mpi_ranks": 16,
      "omp_threads": 4
    },
    {
      "mpi_ranks": 8,
      "omp_threads": 8
    },
    {
      "mpi_ranks": 4,
      "omp_threads": 16
    },
    {
      "mpi_ranks": 2,
      "omp_threads": 32
    }
  ],
  "decompositions": [
    "2d"
  ],
  "exchanges": [
    "blocking"
  ],
  "warmup_runs": 1,
  "repetitions": 5,
  "output": {
    "directory": "outputs/hybrid_node",
    "write_field": false,
    "snapshot_interval": 0
  },
  "metrics_csv": "results/raw/hybrid_node.csv"
}
