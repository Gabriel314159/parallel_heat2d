{
  "schema_version": 5,
  "kind": "strong_scaling",
  "defaults": "benchmark_problem.json",
  "description": "Experiment 1: serial vs MPI (strong scaling over ranks). The fixed problem P on 1, 2, 4, 8 and 16 MPI ranks with one thread each, compared with the pure serial program.",
  "execution": {"backend": "parallel"},
  "decomposition": "2d",
  "exchange": "blocking",
  "include_serial_reference": true,
  "resources": [
    {"mpi_ranks": 1, "omp_threads": 1},
    {"mpi_ranks": 2, "omp_threads": 1},
    {"mpi_ranks": 4, "omp_threads": 1},
    {"mpi_ranks": 8, "omp_threads": 1},
    {"mpi_ranks": 16, "omp_threads": 1}
  ],
  "warmup_runs": 1,
  "repetitions": 5,
  "output": {"directory": "outputs/strong_scaling_mpi", "write_field": false, "snapshot_interval": 0},
  "metrics_csv": "results/raw/strong_scaling_mpi.csv"
}
