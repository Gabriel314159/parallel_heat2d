{
  "schema_version": 2,
  "kind": "weak_scaling",
  "defaults": "../config/defaults.json",
  "description": "Fixed local cells and threads per rank with fixed spatial spacing; the physical domain grows as lx = px*local_nx*dx, ly = py*local_ny*dy. The flow amplitude grows with the domain so that the speed bounds, and hence the automatic dt, stay fixed.",
  "local_nx": 512,
  "local_ny": 512,
  "spacing": {"dx": 0.001, "dy": 0.001},
  "problem": {
    "steps": 1000,
    "kappa": 0.005,
    "flow_epsilon": 0.25, "flow_period": 10.0,
    "case": "pigment_drop", "background": 0.0, "amplitude": 1.0,
    "blob_width": 0.05
  },
  "flow_scaling": "flow_amplitude = 0.1 * lx, so u_max = A*pi/ly and v_max = 2*A*pi*(1+2*eps)/lx are the same for every run (square process grids, lx = ly). blob_centre is the domain centre.",
  "execution": {"backend": "parallel"},
  "decomposition": "2d",
  "exchange": "blocking",
  "resources": [
    {"mpi_ranks": 1, "omp_threads": 4, "process_grid": [1, 1], "problem": {"flow_amplitude": 0.0512, "blob_centre": [0.256, 0.256]}},
    {"mpi_ranks": 4, "omp_threads": 4, "process_grid": [2, 2], "problem": {"flow_amplitude": 0.1024, "blob_centre": [0.512, 0.512]}},
    {"mpi_ranks": 16, "omp_threads": 4, "process_grid": [4, 4], "problem": {"flow_amplitude": 0.2048, "blob_centre": [1.024, 1.024]}}
  ],
  "warmup_runs": 1,
  "repetitions": 5,
  "output": {"directory": "outputs/weak_scaling", "write_field": false, "snapshot_interval": 0},
  "metrics_csv": "results/raw/weak_scaling.csv"
}
