#!/bin/bash
#PBS -S /bin/bash
#PBS -N poisson3d-1n
#PBS -l select=1:ncpus=72:mpiprocs=72
#PBS -l place=excl
#PBS -l walltime=02:00:00
#PBS -j oe

set -eo pipefail
cd "$PBS_O_WORKDIR"
module purge
module load GCC/14.3.0 OpenMPI/5.0.8-GCC-14.3.0
build="build-$PBS_JOBID"
bash ./build.sh "$build"
controls=()
if [[ "${POISSON3D_CONTROLS:-0}" == 1 ]]; then
    controls+=(--include-controls)
fi
python3 run_experiments.py one-node "${controls[@]}" --build-dir "$build" --output "results/$PBS_JOBID"
