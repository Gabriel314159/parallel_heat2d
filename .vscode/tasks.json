{
  "version": "2.0.0",
  "tasks": [
    {"label": "Configure Release", "type": "process", "command": "cmake", "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "-DHEAT2D_BUILD_SOLVERS=ON"], "problemMatcher": []},
    {"label": "Build Release", "type": "process", "command": "cmake", "args": ["--build", "${workspaceFolder}/build", "--parallel", "2"], "dependsOn": "Configure Release", "problemMatcher": ["$gcc"], "group": {"kind": "build", "isDefault": true}},
    {"label": "Validate Quick", "type": "process", "command": "${workspaceFolder}/.venv/bin/python", "args": ["${workspaceFolder}/scripts/check_correctness.py", "--quick"], "options": {"cwd": "${workspaceFolder}"}, "dependsOn": "Build Release", "problemMatcher": []},
    {"label": "Configure Debug", "type": "process", "command": "cmake", "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build-debug", "-DCMAKE_BUILD_TYPE=Debug", "-DHEAT2D_BUILD_SOLVERS=ON"], "problemMatcher": []},
    {"label": "Build Debug", "type": "process", "command": "cmake", "args": ["--build", "${workspaceFolder}/build-debug", "--parallel", "2"], "dependsOn": "Configure Debug", "problemMatcher": ["$gcc"]}
  ]
}
