#!/bin/bash
#PBS -S /bin/bash
#PBS -N modelb-4n
#PBS -q auto
#PBS -l select=4:ncpus=72:mpiprocs=72
#PBS -l place=scatter:excl
#PBS -l walltime=08:00:00
#PBS -j oe
# Four nodes: serial against 256 ranks on a small grid, strong scaling of 1024^3 at
# 256 and 128 ranks, and the whole weak-scaling ladder (about 2^22 cells per rank,
# 162^3 on 1 rank to 1024^3 on 256), every point in this one job.
source "$PBS_O_WORKDIR/big_common.sh"
gate
python3 check_multinode.py --build-dir "$BUILD" --output "$RESULTS/multinode_check" --launcher "$LAUNCHER" \
  > "$RESULTS/multinode_check.log" 2>&1 || { echo "multi-node check failed, see $RESULTS/multinode_check.log"; exit 1; }
tail -1 "$RESULTS/multinode_check.log"
point strong_p256 256 1024 1 0 3 2700
point strong_p128 128 1024 1 0 3 3600
point weak_p1 1 162 2 1 2 1200
point weak_p2 2 204 2 1 2 1200
point weak_p4 4 256 2 1 2 1200
point weak_p8 8 322 2 1 2 1200
point weak_p16 16 406 2 1 2 1800
point weak_p32 32 512 2 1 2 1800
point weak_p64 64 646 2 1 2 2400
point weak_p128 128 812 2 1 2 3600
point weak_p256 256 1024 2 1 2 3600
echo "done: $RESULTS"
