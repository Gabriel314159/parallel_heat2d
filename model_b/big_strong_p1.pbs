#!/bin/bash
#PBS -S /bin/bash
#PBS -N modelb-s1
#PBS -q auto
#PBS -l select=1:ncpus=72:mpiprocs=72
#PBS -l place=excl
#PBS -l walltime=12:00:00
#PBS -j oe
# Strong scaling of 1024^3, the one-core reference: one rank, one time step.
# PROGRESS lines in the run's log give the time per CG iteration even if the wall time ends it.
source "$PBS_O_WORKDIR/big_common.sh"
gate
point strong_p1 1 1024 1 0 1 41400
echo "done: $RESULTS"
