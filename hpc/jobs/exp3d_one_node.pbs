#!/bin/bash
#PBS -S /bin/bash
#PBS -N heat3d_1node
#PBS -l select=1:ncpus=72:mpiprocs=72
#PBS -l place=excl
#PBS -l walltime=04:00:00
#PBS -j oe
# The 3D pigment model on one node (docs/design_3d.md, model A): its correctness
# gate, then 3D experiments 1 (serial reference and 1 to 64 ranks) and 5 (1 to 64 ranks).

source "$PBS_O_WORKDIR/hpc/jobs/common.sh" || exit 1
gate3d
CSV=(--metrics-csv results/raw/strong_scaling_3d_1node.csv)
run --config experiments/strong_scaling_3d.json "${CSV[@]}" "${CORE[@]}" \
    --run serial_reference --run p1_t1_pencils_blocking --run p2_t1_pencils_blocking --run p4_t1_pencils_blocking \
    --run p8_t1_pencils_blocking --run p16_t1_pencils_blocking --run p32_t1_pencils_blocking
run --config experiments/strong_scaling_3d.json "${CSV[@]}" "${SOCKET[@]}" --run p64_t1_pencils_blocking
CSV=(--metrics-csv results/raw/weak_scaling_3d_1node.csv)
run --config experiments/weak_scaling_3d.json "${CSV[@]}" "${CORE[@]}" \
    --run serial_reference --run p1_t1_pencils_blocking --run p4_t1_pencils_blocking --run p16_t1_pencils_blocking
run --config experiments/weak_scaling_3d.json "${CSV[@]}" "${SOCKET[@]}" --run p64_t1_pencils_blocking
