#!/bin/bash
#PBS -S /bin/bash
#PBS -N heat2d_sw_1536
#PBS -l select=1:ncpus=72:mpiprocs=72
#PBS -l place=excl
#PBS -l walltime=03:00:00
#PBS -j oe
# The serial run of the weak-scaled problem on 1536^2 cells (36 ranks), 100 steps: an estimated 25 minutes a run; no warmup, three repetitions.
# Its own CSV (jobs must not share one).

HEAT2D_TIMEOUT=5400
source "$PBS_O_WORKDIR/hpc/jobs/common.sh" || exit 1
gate
run --config experiments/serial_weak_1536.json --metrics-csv results/raw/serial_weak_1536.csv \
    --warmup-runs 0 --repetitions 3 "${CORE[@]}" --run serial_reference
