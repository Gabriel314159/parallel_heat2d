#!/bin/bash
#PBS -S /bin/bash
#PBS -N heat2d_serial_2048
#PBS -l select=1:ncpus=72:mpiprocs=72
#PBS -l place=excl
#PBS -l walltime=03:30:00
#PBS -j oe
# The 2048^2 point of the serial runtime against problem size, 100 steps (about 45 minutes a
# run): no warmup, three repetitions. Its own CSV (jobs must not share one).

HEAT2D_TIMEOUT=7200
source "$PBS_O_WORKDIR/hpc/jobs/common.sh" || exit 1
gate
run --config experiments/serial_size_2048.json --metrics-csv results/raw/serial_sizes_2048.csv \
    --warmup-runs 0 --repetitions 3 "${CORE[@]}" --run serial_reference
